{
  "name": "sport_lounge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "config": {
    "downloadSwaggerSpecFrom": "https://slbe-454806.appspot.com/v3/api-docs",
    "downloadSwaggerSpecLocal": "http://localhost:8080/v3/api-docs",
    "swaggerSpecDir": "./src/swagger-spec/download/",
    "swaggerSpecFileName": "spec.json",
    "specOutPath": "./src/swagger-spec/ts"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "stg": "vite --mode stg",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "download:local-swagger-spec": "cross-var \"mkdirp $npm_package_config_swaggerSpecDir && download $npm_package_config_downloadSwaggerSpecLocal > $npm_package_config_swaggerSpecDir$npm_package_config_swaggerSpecFileName\"",
    "download:dev-swagger-spec": "cross-var \"mkdirp $npm_package_config_swaggerSpecDir && download $npm_package_config_downloadSwaggerSpecFrom > $npm_package_config_swaggerSpecDir$npm_package_config_swaggerSpecFileName\"",
    "update:local-swagger-spec": "npm-run-all download:local-swagger-spec build:swagger-spec",
    "update:dev-swagger-spec": "npm-run-all download:dev-swagger-spec build:swagger-spec",
    "build:swagger-spec": "cross-var \"rimraf $npm_package_config_specOutpath && openapi-generator-cli generate -i $npm_package_config_swaggerSpecDir$npm_package_config_swaggerSpecFileName -g typescript-fetch -o $npm_package_config_specOutPath --skip-validate-spec --additional-properties=npmName=restClient,supportsES6=true,withInterfaces=true,typescriptThreePlus=true\""
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/push-notifications": "^7.0.1",
    "@hookform/resolvers": "^5.0.1",
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.1.2",
    "@react-three/rapier": "^2.1.0",
    "dotenv": "^16.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.1",
    "sass": "^1.89.0",
    "three": "^0.176.0",
    "zod": "^3.25.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@openapitools/openapi-generator-cli": "^2.20.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-var": "^1.1.0",
    "download-cli": "^1.1.1",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
